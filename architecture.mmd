flowchart TD
    U["Lead CSV<br/>(upload via Streamlit UI or CLI)"] --> B["Research tool<br/>extract_hooks_from_notes<br/>(deterministic, no LLM call)"]
    B --> C["Drafting agent<br/>Strands Agent + Anthropic/Bedrock model<br/>writes FIRST_TOUCH + FOLLOW_UP"]
