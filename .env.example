# Copy this file to .env and fill in your key.

# Which model backend every agent uses: "anthropic" (default) or "bedrock".
# WARMINTRO_MODEL_PROVIDER=anthropic

# --- Option A: Anthropic API directly (fastest local setup) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional: override the default model id
# WARMINTRO_MODEL_ID=claude-sonnet-4-5-20250929

# --- Option B: Amazon Bedrock (set WARMINTRO_MODEL_PROVIDER=bedrock) ---
# Uses standard AWS credential resolution (env vars / aws configure / IAM
# role) — no separate API key needed here.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# WARMINTRO_AWS_REGION=us-east-1
# Optional: override the default Bedrock model id
# WARMINTRO_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
